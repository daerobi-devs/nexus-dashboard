# Server Port (3000 inside Docker/Coolify, 5173 for local Vite development)
PORT=3000

# PostgreSQL Central Database Hub (Hydrates & replicates all 26 tables automatically)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@your-postgres-host:5432/buatin_nexus_db"
PG_ADMIN_URL="postgresql://postgres:YOUR_DB_PASSWORD@your-postgres-host:5432/postgres"

# Business & Payment Defaults
BUATIN_BUSINESS_EMAIL="hello@example.com"

# MinIO / S3-Compatible Object Storage Hub
S3_ENDPOINT="http://your-minio-host:9000"
S3_PUBLIC_URL="http://your-minio-host:9000"
S3_CONSOLE_URL="http://your-minio-host:9001"
S3_REGION="us-east-1"
S3_ACCESS_KEY="YOUR_MINIO_USER"
S3_SECRET_KEY="YOUR_MINIO_PASSWORD"
S3_BUCKET="nexus-assets"

# Optional External Infrastructure Panels
CLOUDBEAVER_URL=""
COOLIFY_BASE_URL=""
COOLIFY_TOKEN=""
